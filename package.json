{
  "name": "air-quality-monitoring-across-gcc-citites",
  "description": "Real-time air quality monitoring system for GCC cities using NestJS microservices and RabbitMQ",
  "scripts": {
    "build": "nest build main",
    "build:data-collector": "nest build data-collector",
    "build:alert-processor": "nest build alert-processor",
    "start:dev": "nest start main --watch",
    "start:dev:data-collector": "nest start data-collector --watch",
    "start:dev:alert-processor": "nest start alert-processor --watch",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up",
    "docker:down": "docker-compose down",
    "docker:log": "docker-compose logs"
  },
  "dependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/common": "^11.1.9",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.9",
    "@nestjs/microservices": "^10.3.10",
    "@nestjs/platform-express": "^10.3.10",
    "@prisma/client": "^6.19.0",
    "amqplib": "^0.10.9",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "prisma": "^6.19.0",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@types/node": "^20.14.14",
    "ts-loader": "^9.5.1",
    "typescript": "^5.6.3"
  }
}
